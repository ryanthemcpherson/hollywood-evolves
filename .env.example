AUDIENCE_IMPORT_TOKEN=
# Mount this path on persistent storage in production
AUDIENCE_DATA_PATH=/data/audience-signals.json

# Required together to activate moderated written commentary
PUBLIC_ORIGIN=https://hollywoodevolves.mcpherson.app
COMMENTARY_ENABLED=false
COMMENTARY_SECRET=
COMMENTARY_ADMIN_TOKEN=
COMMENTARY_ADMIN_NAME=
COMMENTARY_DATA_PATH=/data/commentary.json
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://hollywoodevolves.mcpherson.app/auth/linkedin/callback

# Explicit illustrative demo mode; DATABASE_URL is supplied by the Railway PostgreSQL service
DEMO_MODE=false
DATABASE_URL=
