# Required before any audience question is opened
AUDIENCE_HASH_SECRET=
AUDIENCE_IMPORT_TOKEN=
# Mount this path on persistent storage in production
AUDIENCE_DATA_PATH=/data/audience-signals.json

# Account-tied forecasting and LinkedIn sign-in stay off (routes return 404) unless every value below is valid
AUTH_ENABLED=false
DATABASE_URL=
PUBLIC_ORIGIN=https://hollywoodevolves.mcpherson.app
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://hollywoodevolves.mcpherson.app/auth/linkedin/callback
# At least 32 random characters each; generate independently (e.g. openssl rand -base64 48)
AUTH_SECRET=
ADMIN_TOKEN=
ADMIN_NAME=
# Additionally opens the moderated comment routes
COMMENTARY_ENABLED=false
# true behind Railway's proxy so rate limits use the client address from X-Forwarded-For
TRUST_PROXY=false
